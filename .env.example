# Docker 容器用户的 UID/GID。Linux 部署时建议设置为运行 Docker Compose
# 的宿主机用户，可通过 `id -u` 和 `id -g` 查询。macOS/Windows 通常无需修改。
APP_UID=1000
APP_GID=1000

# LLM 提供商（填写你实际使用的提供商对应的 API Key）
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# FRED（美联储宏观经济数据：利率、通胀、就业、经济增长）。
# 可免费申请 API Key：https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# 可选：自定义 OpenAI 兼容接口（例如 vLLM、LM Studio、llama.cpp、
# 中转/代理服务等）。
# 使用时将提供商选择为 "openai_compatible"，并设置基础 URL；
# API Key 为可选项（本地服务器通常不需要 API Key）。
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock（提供商选择 "bedrock"，安装方式：pip install ".[bedrock]"）。
# 身份认证方式：可以使用 Bedrock API Key（Bearer Token，无需 AWS Access Key），
# 或使用 AWS 凭证链（环境变量中的密钥 / ~/.aws/credentials / IAM Role / AWS_PROFILE）。
# 无论使用哪种认证方式，都需要设置 AWS 区域；
# 如果同时配置了 Bearer Token 和 AWS 凭证，则优先使用 Bearer Token。
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# 可选：连接远程 Ollama 服务器。
# 如果未设置，则默认连接本机：
# http://localhost:11434/v1
# 此变量遵循 Ollama 生态中较通用的约定；
# CLI 下拉选择以及程序化调用的客户端都会自动读取此配置。
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# 可选：无需修改代码即可覆盖 DEFAULT_CONFIG 中的默认配置。
# 以下任意 TRADINGAGENTS_* 环境变量一旦设置，
# 都会替换 tradingagents/default_config.py 中对应的配置项。
# 环境变量的值会自动转换为原默认值对应的数据类型
#（bool / int / str），因此 "true"、"3" 等值都能按预期工作。
#
# 在 CLI 模式下，如果设置了 LLM 提供商 / 模型 / 后端 URL / 输出语言，
# 则会跳过对应的交互式选择步骤。
# 这对于 OpenAI 兼容接口（例如 opencode、LM Studio）
# 以及无人值守运行场景非常有用。
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# 采样温度（Temperature）。
# 数值越低，对于支持 Temperature 参数的模型来说，
# 每次运行之间的输出差异通常越小。
# 如果不设置，则使用各个 LLM 提供商自己的默认值。
# 详见 README 中的 "Reproducibility（可复现性）" 说明：
# 无论如何设置，都无法让 LLM 的输出做到完全确定性。
#TRADINGAGENTS_TEMPERATURE=0.0

# LLM SDK 的最大重试次数，该设置会传递给所有提供商。
# 如果不设置，则使用各 SDK 自己的默认值（通常为 2 次）。
# 如果部署环境经常遇到突发性的 HTTP 429 限流，
# 可以适当提高该数值，以便自动重试，而不是直接中止任务。
# 例如 Azure OpenAI 等存在严格速率限制的部署环境。
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# 各提供商特有的推理/思考深度配置（可选；不设置则使用提供商默认值）。
# 设置其中某项后，也会跳过 CLI 中对应的交互式选择步骤。
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# 可选：按 Agent 身份覆盖模型和思考等级。默认关闭，关闭时下方 JSON
# 完全不生效，所有 Agent 继续使用全局 Quick/Deep 模型及思考等级。
# thinking_level 会按当前提供商自动映射：OpenAI-compatible -> reasoning_effort，
# Google -> thinking_level，Anthropic -> effort。省略字段表示继承全局配置；
# 将 thinking_level 显式设为 null 表示该 Agent 使用提供商默认思考等级。
#
# 可用角色：market_analyst, sentiment_analyst, news_analyst,
# fundamentals_analyst, crypto_intelligence_analyst, bull_researcher, bear_researcher, research_manager,
# trader, aggressive_analyst, neutral_analyst, conservative_analyst,
# portfolio_manager
#TRADINGAGENTS_AGENT_LLM_OVERRIDES_ENABLED=false
#TRADINGAGENTS_AGENT_LLM_OVERRIDES='{"market_analyst":{"model":"deepseek-v4-flash","thinking_level":"low"},"crypto_intelligence_analyst":{"model":"gpt-5.6-sol","thinking_level":"medium"},"research_manager":{"model":"gpt-5.6-sol","thinking_level":"high"},"portfolio_manager":{"thinking_level":null}}'

# 可选加密数据源。Decision Horizon、Crypto Intelligence 模式与热力图路径/URL
# 属于每次任务的参数，特意不放在 .env 中。
# Coin Metrics Community 无需 API Key，默认提供基础网络/稳定币数据，以及
# volume_reported_spot_usd_1d 全市场报告现货成交额。后者只作为“全市场活跃程度”
# 交叉验证：当前 UTC 日会被排除，也不会回填 OHLCV Volume 或参与 VWMA/MFI/OBV。
# 它不是付费的 trusted-volume 指标，可能包含低质量交易所或刷量活动。
# 指标说明：https://docs.coinmetrics.io/asset-metrics/volume/volume_reported_spot_usd_1d
# Community API 文档：https://docs.coinmetrics.io/api/v4/
# Coinalyze 提供实际多/空清算历史（不是潜在清算热力图）。当前报告保留
# 最近 168 条小时记录，主要用于确认近期是否发生杠杆出清。
# API Key 申请（登录后生成）：https://coinalyze.net/account/api-key/
# 官方 API 文档：https://api.coinalyze.net/v1/doc/
#COINALYZE_API_KEY=
# 默认 symbol 为 <BASE>USDT_PERP.A；若不适用，可从 Coinalyze 支持列表中选择并覆盖。
#COINALYZE_SYMBOL_OVERRIDE=BTCUSDT_PERP.A

# Dune 备忘（2026-08-22）：当前建议默认禁用，即保留下列三项为空。
# 已核查的公共查询暂不足以作为开箱即用的数据源：
# - 6450054 只返回数据覆盖范围元数据，并非日级 CEX Netflow；
# - 3729167 已过时且当前没有可读取结果；
# - 6946196 的字段形式合适，但目前因地址类型不匹配而执行失败；
# - 6648506 的 ETF 字段可被本项目识别，但缓存结果较旧、依赖查询参数且未可靠按日期倒序。
# 不配置 Dune 不影响主分析流程；Coin Metrics 仍提供轻量级链上背景数据。
#
# 若以后启用，建议先 fork 并自行维护查询，确认最近执行成功且数据新鲜，固定查询参数，
# 并让最终结果按日期倒序。Dune 在本项目中只应作为交叉验证信息，而非主要判断依据。
# 本项目只读取查询最近一次已经执行的结果，不会执行/刷新 SQL、选择查询参数或检查时效性。
#
# Dune API Key 申请入口：https://dune.com/apis-and-connectors
# 申请说明（登录后进入 Settings -> API -> Create new API key）：
# https://docs.dune.com/api-reference/overview/authentication
# 读取结果仍可能消耗 Dune credits。仅配置 API Key 而不配置 Query ID 不会增加 Dune 数据。
#DUNE_API_KEY=
#DUNE_CRYPTO_ONCHAIN_QUERY_ID=
#DUNE_CRYPTO_ETF_QUERY_ID=
# 自建查询应包含 date/day/time/timestamp/block_date/block_time 之一，并建议按日期倒序。
# 推荐字段：
# on-chain: date, asset, exchange, inflow_usd, outflow_usd, netflow_usd
# ETF:      date, fund, inflow_usd, outflow_usd, netflow_usd

# 可选：为 Sentiment Analyst 增加 X Search 作为补充参考源。
# 默认关闭；只有显式设为 true 才会发起请求。
# 它不会替换 Yahoo Finance、StockTwits 或 Reddit，也不会改变主 LLM 提供商；
# 搜索结果会以较保守的权重参与情绪判断，并优先筛选有实际浏览量或讨论量的帖子。
#TRADINGAGENTS_X_SEARCH_ENABLED=false
# 调用兼容模式。xAI 的 X Search 官方同时支持 OpenAI Responses API 形式，
# 两种模式都调用 /responses 并发送 {"type":"x_search"}；普通
# /chat/completions 无法代替服务端 X Search。
# xai 默认使用 https://api.x.ai/v1/responses 和 XAI_API_KEY；
# openai_compatible 默认回退复用全局 TRADINGAGENTS_LLM_BACKEND_URL 和
# OPENAI_COMPATIBLE_API_KEY，以兼容旧配置。兼容模式使用 Responses 的通用
# 子集：日期范围保留在 prompt 中，不向 tools 发送 from_date/to_date，也不
# 发送部分网关会拒绝的 max_output_tokens。
#TRADINGAGENTS_X_SEARCH_PROVIDER=xai
# 可选的 X Search 独立端点和凭据。设置后优先于上述默认/全局配置，因而可以
# 将 Grok OAuth/sub2api 分组与项目主 LLM 的端点、API Key 完全分开。
# BASE_URL 可填写到 /v1 或完整 /v1/responses；程序会自动补齐 /responses。
#TRADINGAGENTS_X_SEARCH_BASE_URL=http://debian13t:8080/v1
#TRADINGAGENTS_X_SEARCH_API_KEY=sk-x-search-only
#TRADINGAGENTS_X_SEARCH_MODEL=grok-4.6
# sub2api Grok Build 示例：TRADINGAGENTS_X_SEARCH_MODEL=grok-build-0.1
# Grok 检索模型的独立思考强度。常用值：low / medium / high；部分模型也支持
# none 或 xhigh。默认 medium，不影响 Sentiment Analyst 及其他 Agent 的强度。
#TRADINGAGENTS_X_SEARCH_THINKING_LEVEL=medium
#TRADINGAGENTS_X_SEARCH_TIMEOUT=60
# 原生 xai 模式的输出上限，同时包含可见回答和 reasoning tokens；
# openai_compatible 模式为兼容严格网关，不发送此可选字段。
#TRADINGAGENTS_X_SEARCH_MAX_OUTPUT_TOKENS=8000
