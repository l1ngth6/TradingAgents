# LLM 提供商（填写你实际使用的提供商对应的 API Key）
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# FRED（美联储宏观经济数据：利率、通胀、就业、经济增长）。
# 可免费申请 API Key：https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# 可选：自定义 OpenAI 兼容接口（例如 vLLM、LM Studio、llama.cpp、
# 中转/代理服务等）。
# 使用时将提供商选择为 "openai_compatible"，并设置基础 URL；
# API Key 为可选项（本地服务器通常不需要 API Key）。
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock（提供商选择 "bedrock"，安装方式：pip install ".[bedrock]"）。
# 身份认证方式：可以使用 Bedrock API Key（Bearer Token，无需 AWS Access Key），
# 或使用 AWS 凭证链（环境变量中的密钥 / ~/.aws/credentials / IAM Role / AWS_PROFILE）。
# 无论使用哪种认证方式，都需要设置 AWS 区域；
# 如果同时配置了 Bearer Token 和 AWS 凭证，则优先使用 Bearer Token。
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# 可选：连接远程 Ollama 服务器。
# 如果未设置，则默认连接本机：
# http://localhost:11434/v1
# 此变量遵循 Ollama 生态中较通用的约定；
# CLI 下拉选择以及程序化调用的客户端都会自动读取此配置。
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# 可选：无需修改代码即可覆盖 DEFAULT_CONFIG 中的默认配置。
# 以下任意 TRADINGAGENTS_* 环境变量一旦设置，
# 都会替换 tradingagents/default_config.py 中对应的配置项。
# 环境变量的值会自动转换为原默认值对应的数据类型
#（bool / int / str），因此 "true"、"3" 等值都能按预期工作。
#
# 在 CLI 模式下，如果设置了 LLM 提供商 / 模型 / 后端 URL / 输出语言，
# 则会跳过对应的交互式选择步骤。
# 这对于 OpenAI 兼容接口（例如 opencode、LM Studio）
# 以及无人值守运行场景非常有用。
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# 采样温度（Temperature）。
# 数值越低，对于支持 Temperature 参数的模型来说，
# 每次运行之间的输出差异通常越小。
# 如果不设置，则使用各个 LLM 提供商自己的默认值。
# 详见 README 中的 "Reproducibility（可复现性）" 说明：
# 无论如何设置，都无法让 LLM 的输出做到完全确定性。
#TRADINGAGENTS_TEMPERATURE=0.0

# LLM SDK 的最大重试次数，该设置会传递给所有提供商。
# 如果不设置，则使用各 SDK 自己的默认值（通常为 2 次）。
# 如果部署环境经常遇到突发性的 HTTP 429 限流，
# 可以适当提高该数值，以便自动重试，而不是直接中止任务。
# 例如 Azure OpenAI 等存在严格速率限制的部署环境。
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# 各提供商特有的推理/思考深度配置（可选；不设置则使用提供商默认值）。
# 设置其中某项后，也会跳过 CLI 中对应的交互式选择步骤。
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# 可选：按 Agent 身份覆盖模型和思考等级。默认关闭，关闭时下方 JSON
# 完全不生效，所有 Agent 继续使用全局 Quick/Deep 模型及思考等级。
# thinking_level 会按当前提供商自动映射：OpenAI-compatible -> reasoning_effort，
# Google -> thinking_level，Anthropic -> effort。省略字段表示继承全局配置；
# 将 thinking_level 显式设为 null 表示该 Agent 使用提供商默认思考等级。
#
# 可用角色：market_analyst, sentiment_analyst, news_analyst,
# fundamentals_analyst, bull_researcher, bear_researcher, research_manager,
# trader, aggressive_analyst, neutral_analyst, conservative_analyst,
# portfolio_manager
#TRADINGAGENTS_AGENT_LLM_OVERRIDES_ENABLED=false
#TRADINGAGENTS_AGENT_LLM_OVERRIDES='{"market_analyst":{"model":"deepseek-v4-flash","thinking_level":"low"},"research_manager":{"model":"gpt-5.6-sol","thinking_level":"high"},"portfolio_manager":{"thinking_level":null}}'

# 可选：为 Sentiment Analyst 增加 X Search 作为补充参考源。
# 默认关闭；只有显式设为 true 才会发起请求。
# 它不会替换 Yahoo Finance、StockTwits 或 Reddit，也不会改变主 LLM 提供商；
# 搜索结果会以较保守的权重参与情绪判断，并优先筛选有实际浏览量或讨论量的帖子。
#TRADINGAGENTS_X_SEARCH_ENABLED=false
# 默认 xai：使用 https://api.x.ai/v1/responses 和 XAI_API_KEY。
# 可设为 openai_compatible：复用 TRADINGAGENTS_LLM_BACKEND_URL 和
# OPENAI_COMPATIBLE_API_KEY；该端点必须支持 /responses 并透传 {"type":"x_search"}。
# 例如 sub2api 的 Grok OAuth/订阅分组可使用此模式；此模式无需 XAI_API_KEY，
# 但 OPENAI_COMPATIBLE_API_KEY 必须有权访问所填写的 Grok 模型。
#TRADINGAGENTS_X_SEARCH_PROVIDER=xai
#TRADINGAGENTS_X_SEARCH_MODEL=grok-4.6
# sub2api Grok Build 示例：TRADINGAGENTS_X_SEARCH_MODEL=grok-build-0.1
#TRADINGAGENTS_X_SEARCH_TIMEOUT=60
# 输出上限同时包含可见回答和模型的 reasoning tokens，建议保留较高余量。
#TRADINGAGENTS_X_SEARCH_MAX_OUTPUT_TOKENS=8000
